<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven counterpart of consumer-check/build.gradle: resolves com.aresstack:playwright4j (from the
  local repository after publishToMavenLocal, else Maven Central) together with the Playwright Java
  API exactly as documented in the README, using the published POM rather than Gradle module
  metadata. Run: mvn -B -f consumer-check/pom.xml verify -Dplaywright4j.version=<v>
  The enforcer rule fails if Microsoft's Node driver (driver, driver-bundle) reaches the classpath.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.aresstack.playwright4j</groupId>
  <artifactId>playwright4j-consumer-check</artifactId>
  <version>1</version>
  <packaging>pom</packaging>

  <properties>
    <playwright4j.version>0.1.0-SNAPSHOT</playwright4j.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.aresstack</groupId>
      <artifactId>playwright4j</artifactId>
      <version>${playwright4j.version}</version>
    </dependency>
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>1.62.0</version>
      <exclusions>
        <exclusion><groupId>com.microsoft.playwright</groupId><artifactId>driver</artifactId></exclusion>
        <exclusion><groupId>com.microsoft.playwright</groupId><artifactId>driver-bundle</artifactId></exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Enforcer first: it checks the dependency graph before dependency:list resolves the jars. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>no-node-driver</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.microsoft.playwright:driver</exclude>
                    <exclude>com.microsoft.playwright:driver-bundle</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>list-resolved</id>
            <phase>validate</phase>
            <goals><goal>list</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
